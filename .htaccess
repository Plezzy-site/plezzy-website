DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect any direct browser request for /index.html to clean root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 2. 301 Redirect direct requests for *.html to clean URL (e.g. /collections.html -> /collections)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html [NC]
  RewriteRule ^([^\ ]+)\.html$ /$1 [R=301,L]

  # ── HOSTINGER PHP REST API ROUTING ────────────────────────────
  RewriteRule ^api/products/?$ /api/products.php [QSA,L]
  RewriteRule ^api/products/([a-zA-Z0-9_-]+)/?$ /api/products.php?id=$1 [QSA,L]
  RewriteRule ^api/orders/export/?$ /api/orders.php?export=csv [QSA,L]
  RewriteRule ^api/orders/([a-zA-Z0-9_-]+)/status/?$ /api/orders.php?id=$1&action=status [QSA,L]
  RewriteRule ^api/orders/([a-zA-Z0-9_-]+)/?$ /api/orders.php?id=$1 [QSA,L]
  RewriteRule ^api/orders/?$ /api/orders.php [QSA,L]
  RewriteRule ^api/customers/?$ /api/customers.php [QSA,L]
  RewriteRule ^api/admin/stats/?$ /api/stats.php [QSA,L]
  RewriteRule ^api/upload/?$ /api/upload.php [QSA,L]
  RewriteRule ^api/auth/otp/send/?$ /api/otp.php?action=send [QSA,L]
  RewriteRule ^api/auth/otp/verify/?$ /api/otp.php?action=verify [QSA,L]
  RewriteRule ^api/setup/?$ /api/setup.php [QSA,L]

  # 3. Internally rewrite clean URL to the corresponding .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

  # 4. Fallback for SPA routing (only if not root, not existing file, and not existing directory)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# ── HIGH-PERFORMANCE GZIP & DEFLATE COMPRESSION ────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# ── BROWSER EXPIRES & AGGRESSIVE CACHING ────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Always check for updates
  ExpiresByType text/html "access plus 0 seconds"

  # Static Assets: 1 Year Cache
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"

  # Fonts: 1 Year Cache
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # Media & Images: 1 Year Cache
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# ── CACHING & SECURITY HEADERS ─────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
    Header set X-Robots-Tag "index, follow"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|wasm|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Security & Performance Boost
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
