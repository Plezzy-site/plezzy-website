<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect index.html and index.php to clean root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(html|php) [NC]
  RewriteRule ^index\.(html|php)$ / [R=301,L]

  # 2. 301 Redirect any *.html to clean URL (e.g. /collections.html -> /collections)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html [NC]
  RewriteRule ^([^\ ]+)\.html$ /$1 [R=301,L]

  # 3. Internally rewrite clean URL to the underlying .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]

  # 4. Fallback for single-page app routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Caching & MIME types for high performance
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|woff2?|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
